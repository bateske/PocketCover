{
  "name": "pocket-cover",
  "version": "19.0.0",
  "description": "Deterministic, dependency-free 128x128 procedural pixel-art cover and avatar generator, made for CHGame handheld cover art",
  "keywords": [
    "pixel-art",
    "procedural",
    "avatar",
    "cover-art",
    "generator",
    "chgame",
    "deterministic",
    "canvas",
    "128x128"
  ],
  "license": "MIT",
  "author": "bateske",
  "homepage": "https://github.com/bateske/PocketCover#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bateske/PocketCover.git"
  },
  "bugs": {
    "url": "https://github.com/bateske/PocketCover/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js",
    "./raster": "./src/raster.js",
    "./masks": "./src/masks.js",
    "./materials": "./src/materials.js",
    "./geometry": "./src/geometry.js",
    "./variation": "./src/variation.js",
    "./recipes/*": "./src/recipes/*.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE.txt"
  ],
  "scripts": {
    "test": "node --test",
    "examples": "node scripts/examples.mjs",
    "review": "node scripts/pixel-review.mjs",
    "standalone": "node scripts/standalone.mjs",
    "start": "node scripts/serve.mjs",
    "digest": "node scripts/digest.mjs",
    "compare": "node scripts/compare.mjs",
    "banner": "node scripts/banner.mjs",
    "social": "node scripts/social.mjs"
  }
}
